# Production worker image: Node + FFmpeg + fonts (subtitles are rendered with sharp/librsvg and need system fonts).
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core fonts-liberation ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ENV NODE_ENV=production
# The worker needs the same env vars as the web app (see .env.example), notably the service-role key.
CMD ["npx", "tsx", "workers/production-worker.ts"]
